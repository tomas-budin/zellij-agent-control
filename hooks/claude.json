{
  "Notification": [
    {
      "matcher": "*",
      "hooks": [
        { "type": "command", "command": "zj agent-state hook claude", "timeout": 5 }
      ]
    }
  ],
  "PermissionRequest": [
    {
      "matcher": "*",
      "hooks": [
        { "type": "command", "command": "zj agent-state hook claude", "timeout": 5 }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "*",
      "hooks": [
        { "type": "command", "command": "zj agent-state hook claude", "timeout": 5 }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        { "type": "command", "command": "zj agent-state hook claude", "timeout": 5 }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        { "type": "command", "command": "zj agent-state hook claude", "timeout": 5 }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        { "type": "command", "command": "zj agent-state hook claude", "timeout": 5 }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        { "type": "command", "command": "zj tab-title", "timeout": 5 },
        { "type": "command", "command": "zj agent-state hook claude", "timeout": 5 }
      ]
    }
  ]
}
