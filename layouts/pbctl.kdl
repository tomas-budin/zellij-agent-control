layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="pbctl" split_direction="vertical" {
        pane cwd="/Users/tomasbudin/work/repos"
        pane cwd="/Users/tomasbudin/scripts"
    }
    tab name="pb-ml-services logs" {
        pane command="bash" {
            args "-c" "~/scripts/pbctl-tail-service-logs.sh pb-ml-services"
        }
    }
    tab name="pb-navigation logs" {
        pane command="bash" {
            args "-c" "~/scripts/pbctl-tail-service-logs.sh pb-navigation"
        }
    }
    tab name="pb-universe logs" {
        pane command="bash" {
            args "-c" "~/scripts/pbctl-tail-service-logs.sh pb-universe"
        }
    }
}
