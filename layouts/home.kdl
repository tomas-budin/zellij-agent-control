layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="yazi" {
        pane command="zsh" {
            args "-c" "yazi; exec zsh"
        }
    }
    tab name="obsidian" {
        pane cwd="/Users/tomasbudin/Google Drive/My Drive/Obsidian/Extended Brain" command="nvim"
    }
}
