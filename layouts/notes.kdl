layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="notes" {
        pane cwd="/Users/tomasbudin/Library/CloudStorage/ProtonDrive-tomas.budin@proton.me-folder/work/workspace/docs" command="nvim" 
    }
}
