#!/bin/sh
# Pick a session with fzf, hide this tab's floating layer, switch.
# Labels come from $ZJ_HOME/session-names: "<session> <label>".
# Badges come from `zj agent-state summary`: blue ▶ agents running, yellow ● conversations waiting for me.
# Sessions with running agents sort first, then waiting, then the rest, each group by label.
: "${ZJ_HOME:=$HOME/.config/zellij}"
names="$ZJ_HOME/session-names"
state=$(mktemp)
trap 'rm -f "$state"' EXIT
zj agent-state summary > "$state" 2>/dev/null
target=$(zellij list-sessions -s \
    | awk -v f="$names" -v s="$state" -v cur="$ZELLIJ_SESSION_NAME" '
        BEGIN {
            while ((getline l < f) > 0) {
                if (l ~ /^[ \t]*(#|$)/) continue
                n = l; sub(/[ \t].*/, "", n)
                sub(/^[^ \t]+[ \t]+/, "", l)
                if (l != "") label[n] = l
            }
            while ((getline l < s) > 0) {
                split(l, a, "\t")
                b = ""
                if (a[2] > 0) b = b " \033[34m▶ " a[2] "\033[0m"
                if (a[3] > 0) b = b " \033[33m● " a[3] "\033[0m"
                badge[a[1]] = b
                rank[a[1]] = (a[2] > 0) ? 0 : (a[3] > 0) ? 1 : 2
            }
        }
        {
            name[NR] = $0
            lab[NR] = ($0 in label) ? label[$0] : $0
            if (length(lab[NR]) > w) w = length(lab[NR])
        }
        END {
            for (i = 1; i <= NR; i++)
                printf "%s\t%d\t%-" (w + 6) "s%s%s\n", name[i], (name[i] in rank) ? rank[name[i]] : 2, \
                    lab[i], badge[name[i]], (name[i] == cur) ? "  \033[2m(current)\033[0m" : ""
        }' \
    | sort -t "$(printf '\t')" -k2,2n -k3,3f \
    | fzf --ansi --delimiter='\t' --with-nth=3 --prompt='session> ' --reverse --no-info \
    | cut -f1)
zellij action hide-floating-panes
[ -n "$target" ] && [ "$target" != "$ZELLIJ_SESSION_NAME" ] && zellij action switch-session -- "$target"
exit 0
